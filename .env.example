# API key required (defense in depth on top of WG tunnel)
API_KEY=change-me-to-a-random-secret

# WireGuard client config — place your wg0.conf in the wireguard/ directory.
# See wireguard/wg0.conf.example for the expected format.
# The real wireguard/wg0.conf is git-ignored; never commit private keys.

# CORS allowed origins for browser clients (comma-separated).
# Example: CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Default in code is "*" if this is omitted.
# CORS_ALLOW_ORIGINS=http://localhost:5173

# How long to keep completed/failed jobs in memory (seconds, default 3600)
# JOB_TTL_SECONDS=3600

# Max upload file size in MB (default 500)
# MAX_UPLOAD_SIZE_MB=500

# --- WhisperX ---
WHISPER_MODEL=medium
WHISPER_BATCH_SIZE=16
ENABLE_DIARIZATION=true

# HuggingFace token for pyannote diarization (https://hf.co/settings/tokens)
# Required if ENABLE_DIARIZATION=true. Also accept the model licenses at:
#   https://hf.co/pyannote/speaker-diarization-3.1
#   https://hf.co/pyannote/segmentation-3.0
HF_TOKEN=change-me-to-your-huggingface-token
