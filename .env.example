# Tailscale sidecar — join your tailnet on boot
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
TS_HOSTNAME=whisper-api

# API key still required (defense in depth) — callers must send in X-API-Key header
API_KEY=change-me-to-a-random-secret

# How long to keep completed/failed jobs in memory (seconds, default 3600)
# JOB_TTL_SECONDS=3600

# Max upload file size in MB (default 500)
# MAX_UPLOAD_SIZE_MB=500
