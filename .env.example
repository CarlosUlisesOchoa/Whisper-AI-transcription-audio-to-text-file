# API key — requests must include this in the X-API-Key header
API_KEY=change-me-to-a-random-secret

# Comma-separated IPs allowed to access the API (your VPS IP)
# Leave empty or remove to allow all IPs
ALLOWED_IPS=

# How long to keep completed/failed jobs in memory (seconds, default 3600)
# JOB_TTL_SECONDS=3600

# Max upload file size in MB (default 500)
# MAX_UPLOAD_SIZE_MB=500
